# Keep source bytes stable across native CI checkouts.
* text=auto eol=lf
# Preserve upstream parser and license bytes; validate whitespace in our source.
/scripts/palma_scan/_vendor/** linguist-vendored -whitespace
/THIRD_PARTY_NOTICES.md -whitespace
/examples/** linguist-generated
/examples/report.html -whitespace
/examples/share.html -whitespace
# cmd.exe reads batch files reliably only with CRLF line endings.
*.cmd text eol=crlf
